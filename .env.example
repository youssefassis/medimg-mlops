# Copy to .env and change every "change-me" value. Never commit .env.
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change-me

# RustFS (S3-compatible object store). Secret must be at least 8 characters.
S3_ACCESS_KEY=mlops
S3_SECRET_KEY=change-me-please
